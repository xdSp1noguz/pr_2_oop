  usecase "Перегляд моделі" as UC4
  usecase "Коментування моделі" as UC5
  usecase "Затвердження концепту" as UC6
  usecase "Перевірка конфліктів" as UC7
  usecase "Надсилання запиту на уточнення" as UC8
  usecase "Сповіщення зацікавлених" as UC9
}

Architect --> UC1

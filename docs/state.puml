stateDiagram-v2
    [*] --> Створено : Архітектор створює 3D-модель
    Створено --> Опубліковано : Архітектор публікує модель
    Опубліковано --> На_рецензії : Модель доступна для рецензування

    На_рецензії --> Конфлікти_виявлені : Інженер перевіряє конфлікти
    На_рецензії --> Затверджено : Замовник затверджує концепт
    На_рецензії --> На_коментарях : Замовник коментує

    На_коментарях --> На_рецензії : Архітектор враховує коментарі
    Конфлікти_виявлені --> Запит_на_уточнення : Інженер надсилає запит на уточнення
    Запит_на_уточнення --> Виправлено_Архітектором : Архітектор випускає оновлення

    Виправлено_Архітектором --> Опубліковано : Оновлену версію опубліковано

    Затверджено --> [*] : Проект завершено

    %% Додаткові описи у вигляді note
    state На_рецензії {
      [*] --> Очікує_дій
      Очікує_дій --> Затверджено : Затвердження
      Очікує_дій --> Конфлікти_виявлені : Інженер_знайшов_конфлікти
      Очікує_дій --> На_коментарях : Коментар_замовника
    }
    note right of Опубліковано
      Архітектор публікує версію моделі.
    end note
    note left of Конфлікти_виявлені
      Інженер перевіряє модель і може виявити конфлікти.
    end note
    note right of Затверджено
      Замовник затвердив фінальну версію моделі.
    end note